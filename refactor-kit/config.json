{
  "repo_url": "https://github.com/apache/commons-cli.git",
  "tag": "rel/commons-cli-1.9.0",
  "source_root": "src/main/java/org/apache/commons/cli",
  "smells_workbook": "smells/CommonsCLI_1.9.0_Code_Smells.xlsx",
  "targets_file": "smells/targets.json",
  "log_workbook": "Refactoring_Log.xlsx",
  "maven_cmd": "mvn",
  "maven_args": [
    "-B",
    "clean",
    "test",
    "-Drat.skip=true",
    "-Djacoco.skip=true"
  ],
  "maven_extra_args": [],
  "test_timeout_minutes": 30,
  "metrics": [
    "Size",
    "Cohesion",
    "Coupling"
  ],
  "metric_tool": {
    "_about": "Used by `python kit.py metrics`. CK columns per metric name in 'metrics'; aggregate = sum or mean over the counted classes (see runs/<llm>/<ID>/metrics.md).",
    "maven_coords": "com.github.mauricioaniche:ck:0.7.0",
    "definitions": {
      "Size": {
        "ck": "loc",
        "aggregate": "sum",
        "label": "LOC (CK loc)"
      },
      "Cohesion": {
        "ck": "lcom*",
        "aggregate": "mean",
        "label": "LCOM* (CK lcom*, Henderson-Sellers; 0 = cohesive, 1 = no cohesion)"
      },
      "Coupling": {
        "ck": "cbo",
        "aggregate": "sum",
        "label": "CBO (CK cbo)"
      }
    }
  }
}
